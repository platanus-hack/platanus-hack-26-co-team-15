{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 -m venv .venv && .venv/bin/pip install --disable-pip-version-check -q -r plomada/requirements.txt && .venv/bin/python plomada/build.py",
  "outputDirectory": "plomada/site",
  "installCommand": "echo 'sin dependencias de Node: el bundle de estilo.css y Leaflet ya estan versionados'",
  "framework": null,
  "github": {
    "silent": true
  },
  "rewrites": [
    {
      "source": "/contrato/(.*)",
      "destination": "/contrato/index.html"
    },
    {
      "source": "/municipio/(.*)",
      "destination": "/municipio/index.html"
    },
    {
      "source": "/entidad/(.*)",
      "destination": "/entidad/index.html"
    },
    {
      "source": "/proveedor/(.*)",
      "destination": "/proveedor/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/datos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/static/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
